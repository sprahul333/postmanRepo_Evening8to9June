		{
			"name": "Create Users",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"//pm --> Represents a postman object\r",
							"\r",
							"//L --> Local Variable (Scope is only during the time of the execution)\r",
							"//D --> Data Variable (Data that we read from JSON or CSV Files)\r",
							"//E --> Environment Variable (If we need to maintain seperate details for QA, DEV and other environements for URL)\r",
							"//C --> Collection Variable (Stored at a collection variable)\r",
							"//G --> Global Variable (Accessible across the whole postman tool)\r",
							"\r",
							"//pm.variables --> Determines a local variable\r",
							"\r",
							"//pm.response() --> Determines the response generated\r",
							"//pm.response.json() --> Determines the response in the form of JSON Format\r",
							"\r",
							"const jsonBody=pm.response.json(); //Storing the response in the form of JSOn to jsonBody Variable\r",
							"\r",
							"const userID=jsonBody[\"id\"]; //Fetching the user ID from the JSON payload\r",
							"\r",
							"pm.variables.set(\"User_ID\",userID);\r",
							"\r",
							"//pm.test --> Represents a test case\r",
							"\r",
							"pm.test(\"Validating the JSON Response\",function(){\r",
							"\r",
							"    //pm.expect --> Assertion Library from Chai JS Team\r",
							"\r",
							"    //Checking whether the id attribute is a number or not\r",
							"    pm.expect(jsonBody[\"id\"]).to.be.a(\"number\");\r",
							"\r",
							"    //Checking whether the value of email is present in the JSON payload\r",
							"    pm.expect(jsonBody[\"email\"]).is.not.null;\r",
							"    //Checking whether the value of email is not undefined(Meaningful Value) in the JSON payload\r",
							"    pm.expect(jsonBody[\"email\"]).is.not.undefined;\r",
							"\r",
							"    //Checking whether we have the given json keys in the response body\r",
							"    pm.expect(jsonBody).to.have.keys([\"id\",\"name\",\"email\",\"gender\",\"status\"]);\r",
							"\r",
							"    //Checking whether the gender is present in the expected data set\r",
							"    //Expected Data Set: Male, Female, Others\r",
							"\r",
							"    //Declaring a JS Array\r",
							"    let genders=[\"MALE\",\"FEMALE\",\"OTHERS\"];\r",
							"\r",
							"    //Checking whether the gender is present in the array or not\r",
							"    //.includes is like contains function in JAVA\r",
							"    pm.expect(genders).includes(jsonBody[\"gender\"].toUpperCase()); \r",
							"\r",
							"    //Checking whether the email id contains @ and .com\r",
							"    pm.expect(jsonBody[\"email\"]).includes(\"@\").includes(\".com\");\r",
							"});\r",
							"\r",
							"\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
