		{
			"name": "Get Users - Query parameters",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"\r",
							"pm.test(\"Check if the response body contains the correct number of users\", \r",
							"            function () {\r",
							"//const means no one cannot change the data of the variable\r",
							"const response = pm.response.json();\r",
							"\r",
							"let queryParameters=pm.request.url.query; //Getting the array of query Parameters\r",
							"\r",
							"let noOfPages=queryParameters.filter(queryParameters=> queryParameters.key == \"per_page\").value;\r",
							"    console.log(noOfPages + \" No Of Pages\");\r",
							"\r",
							"if(noOfPages==undefined) //If the per_page attribute is not found in query parameter, the it returns undefined \r",
							"//If the value is undefined, then set the total number of pages as 10\r",
							"{\r",
							"    noOfPages=\"10\";\r",
							"}\r",
							"\r",
							"\r",
							"var listOfUserID=response.filter(response => response[\"status\"]=='Active' && response[\"gender\"].toUpperCase()=='MALE')\r",
							"    .map(response=>response[\"id\"]);\r",
							"\r",
							"//Convert a String to a number --> Number(<string_variable>);\r",
							"pm.expect(listOfUserID.length).to.be.lessThanOrEqual(Number(noOfPages));\r",
							"\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
