	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"packages": {},
				"exec": [
					"\r",
					"//pm.iterationData() --> Will help us in reading the data from the csv/json file\r",
					"//Whatever data that we have read we are converting into a Javascript object\r",
					"\r",
					"//If we are unable to fetch the data from CSV File, then generate a random set of data\r",
					"//Else read the data from the CSV/JSON File\r",
					"if(pm.iterationData.get(\"Name\") == undefined)\r",
					"{\r",
					"    //This tab is used to perform the pre-defined activities, preliminary activities before trigerring the api call\r",
					"\r",
					"let genders = [\"male\", \"female\"];\r",
					"\r",
					"//Math.random() --> Returns a value between 0 and 1\r",
					"//Math.floor() --> Takes the floor/lowest value (Ex: 5.6 --> Floor of 5.6 is 5)\r",
					"//genders.length --> Returns the size of the array (3)\r",
					"//Math.floor(Math.random() * genders.length) --> Picks a random values between 0 and size of the array \r",
					"let randomGender = genders[Math.floor(Math.random() * genders.length)];\r",
					"\r",
					"//It is used to print the data onto the console\r",
					"console.log(randomGender);\r",
					"\r",
					"pm.variables.set(\"Gender\", randomGender);\r",
					"\r",
					"let status = [\"active\", \"inactive\"];\r",
					"\r",
					"let randomStatus = status[Math.floor(Math.random() * status.length)];\r",
					"\r",
					"pm.variables.set(\"Status\", randomStatus);\r",
					"\r",
					"//Whatever value that is generated from the random function, we are storing it in a local variable\r",
					"pm.variables.set(\"Name\", \"{{$randomFirstName}}\");\r",
					"pm.variables.set(\"Email\", \"{{$randomEmail}}\");\r",
					"\r",
					"//In the older versions of POSTMAN, we can use the following syntax to replace the variable with the random value\r",
					"// pm.variables.set(\"DummyValue\",pm.variables.replaceIn(\"{{$randomFirstName}}\"));\r",
					"\r",
					"// console.log(pm.variables.get(\"DummyValue\"));\r",
					"\r",
					"}\r",
					"\r",
					"else \r",
					"{\r",
					"    //Data that is being pushed from CSV/JSON file will be stored in the collection variables\r",
					"    pm.collectionVariables.set(\"requestData\",pm.iterationData.toObject());\r",
					"}\r",
					"\r",
					"pm.request.headers.add({\r",
					"        key: 'Authorization',\r",
					"        value: pm.collectionVariables.get(\"authToken\")\r",
					"    });\r",
					"\r",
					"pm.request.headers.add({\r",
					"        key: 'Content-Type',\r",
					"        value: pm.globals.get(\"contentType\")\r",
					"    });\r",
					"\r",
					""
				]
			}
		},
