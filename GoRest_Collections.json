				"type": "text/javascript",
				"packages": {},
				"exec": [
					"pm.test(\"Validating the Response Time\",function(){\r",
					"    //pm.response.responseTime --> Returns the time taken to generate the response\r",
					"    pm.expect(pm.response.responseTime).to.be.lessThan(2000); //Response time should be less than 2000 milli seconds\r",
					"});\r",
					"\r",
					"// pm.request.method --> Tells what kind of HTTP Call is being performed\r",
					"// pm.request.name --> Returns the name of the end point\r",
					"\r",
					"if(pm.request.method.toUpperCase() == 'GET')\r",
					"{\r",
					"    //pm.info.requestName --> It is used to get the name of the API Request that we are performing\r",
					"    if(pm.info.requestName.toUpperCase() == 'CONFIRM USER DELETED')\r",
					"    {\r",
					"        pm.test(\"Validating the status code\",function(){\r",
					"                //pm.response.code --> Returns the status code\r",
					"                pm.expect(pm.response.code).to.eql(404); //404 --> Page/Record not found\r",
					"            });\r",
					"    }\r",
					"\r",
					"    else {\r",
					"        pm.test(\"Validating the status code\",function(){\r",
					"            //pm.response.code --> Returns the status code\r",
					"            pm.expect(pm.response.code).to.eql(200); //200 --> Response Generated Successfully\r",
					"        });\r",
					"    }\r",
					"}\r",
					"\r",
					"else if(pm.request.method.toUpperCase() == 'POST')\r",
					"{\r",
					"    pm.test(\"Validating the status code\",function(){\r",
					"        //pm.response.code --> Returns the status code\r",
					"        pm.expect(pm.response.code).to.eql(201); //201 --> Response Generated and along with that resource is created\r",
					"    });\r",
					"}\r",
					"\r",
					"else if(pm.request.method.toUpperCase() == 'PUT' || pm.request.method.toUpperCase() == 'PATCH')\r",
					"{\r",
					"    pm.test(\"Validating the status code\",function(){\r",
					"        //pm.response.code --> Returns the status code\r",
					"        pm.expect(pm.response.code).to.eql(200); //200 --> Response Generated Successfully\r",
					"    });\r",
					"}\r",
					"\r",
					"else if(pm.request.method == 'DELETE')\r",
					"{\r",
					"    pm.test(\"Validating the status code\",function(){\r",
					"        //pm.response.code --> Returns the status code\r",
					"        pm.expect(pm.response.code).to.eql(204); //204 --> Request is processed successfully but there is no information from the server to be displayed\r",
					"        \r",
					"    });\r",
					"}\r",
					""
				]
